<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_general">
        <!-- Con el ícono escondido no hay inicio: desde acá (o el atajo del ícono) se llega a las estadísticas -->
        <Preference app:key="stats" app:title="@string/stats_title" />
        <ListPreference
            app:key="language"
            app:title="@string/language"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:useSimpleSummaryProvider="true" />
        <Preference app:key="guide" app:title="@string/pref_guide" app:summary="@string/pref_guide_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_permissions">
        <Preference app:key="perm_notif" app:title="@string/pref_notif" />
        <Preference app:key="perm_links" app:title="@string/pref_links"
            app:summary="@string/pref_links_summary" />
        <Preference app:key="perm_guard" app:title="@string/pref_guard" />
        <Preference app:key="perm_restricted" app:title="@string/gray_title"
            app:summary="@string/pref_restricted_summary" app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <!-- Modo dormir, foco, compromiso e Instagram/YouTube tienen sus propias pantallas (PanelActivity) -->
    <PreferenceCategory app:title="@string/pref_cat_rules">
        <Preference app:key="panel_sleep" app:title="@string/home_sleep" />
        <Preference app:key="panel_focus" app:title="@string/home_focus" />
        <Preference app:key="panel_commit" app:title="@string/home_commit" />
        <Preference app:key="panel_apps" app:title="@string/panel_apps" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_protection">
        <Preference app:key="shield_info" app:title="@string/pref_shield" app:summary="@string/pref_shield_summary"
            app:selectable="false" />
        <SwitchPreferenceCompat
            app:key="hide_icon"
            app:defaultValue="false"
            app:title="@string/pref_hide_icon"
            app:summary="@string/pref_hide_icon_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_bypass">
        <Preference app:key="bypass_now" app:title="@string/bypass_now" />
        <ListPreference
            app:key="bypass_minutes"
            app:defaultValue="10"
            app:title="@string/pref_bypass_minutes"
            app:summary="@string/pref_bypass_summary"
            app:entries="@array/bypass_entries"
            app:entryValues="@array/bypass_values" />
        <Preference
            app:key="bypass_tile"
            app:title="@string/pref_tile"
            app:summary="@string/pref_tile_summary"
            app:isPreferenceVisible="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_updates">
        <SwitchPreferenceCompat
            app:key="remote_rules"
            app:defaultValue="true"
            app:title="@string/pref_rules"
            app:summary="@string/pref_rules_summary" />
        <SwitchPreferenceCompat
            app:key="check_updates"
            app:defaultValue="true"
            app:title="@string/pref_updates" />
        <Preference app:key="check_now" app:title="@string/pref_check_now" />
        <Preference app:key="version" app:title="@string/pref_version" app:selectable="false" />
    </PreferenceCategory>
</PreferenceScreen>
