    <string name="onb_welcome_title">Hi, this is Lúcido</string>
    <string name="onb_f1_title">No endless Reels or Shorts</string>
    <string name="onb_f1_sub">Instagram and YouTube as usual, minus the scroll that never ends. What friends send you still plays.</string>
    <string name="onb_f2_sub">At night, Instagram is messages-only and YouTube is blocked.</string>
    <string name="onb_f3_sub">Your hours to focus: Instagram is messages-only.</string>
    <string name="onb_f4_title">Commitment and stats</string>
